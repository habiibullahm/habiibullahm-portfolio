---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import ScrollTop from "../components/ScrollTop.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Skip-link target; must exist on the page (e.g. #main). */
  skipHref?: string;
  /** @deprecated Scroll-spy self-activates on the homepage via astro:page-load. */
  enableScrollSpy?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  skipHref = "#main",
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;
const socialImage = new URL("/images/projects/task-management.png", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#111114" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        if (!location.hash || location.hash === "#") return;
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
        document.documentElement.classList.add("await-hash");
      })();
    </script>
  </head>
  <body>
    <a
      href={skipHref}
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-mist"
    >
      Skip to content
    </a>
    <slot />
    <ScrollTop />
    <script>
      import "../scripts/hash-scroll.ts";
      import "../scripts/scroll-spy.ts";
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
