---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeExternalUrl, safeSitePath, site } from "../../data/site";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;

const live = data.links?.live ? safeExternalUrl(data.links.live) : null;
const repo = data.links?.repo ? safeExternalUrl(data.links.repo) : null;
const imageSrc = data.image ? safeSitePath(data.image) : null;

type PreviewImage = {
  type: "image";
  src: string;
  thumb: string;
  alt: string;
};
type PreviewVideo = {
  type: "video";
  src: string;
  srcMp4?: string;
  poster?: string;
  alt: string;
};
type PreviewEmbed = { type: "embed"; src: string; title: string };
type PreviewItem = PreviewImage | PreviewVideo | PreviewEmbed;

function thumbPath(src: string): string {
  if (src.endsWith("assistant-preview.webp")) return src;
  return src.replace(/(\.[^.]+)$/, "-thumb$1");
}

const previews = (data.previews ?? [])
  .map((item): PreviewItem | null => {
    if (item.type === "embed") {
      const src = safeExternalUrl(item.src);
      return src ? { type: "embed", src, title: item.title } : null;
    }
    const src = safeSitePath(item.src);
    if (!src) return null;
    if (item.type === "video") {
      const srcMp4 = item.srcMp4 ? safeSitePath(item.srcMp4) : undefined;
      const poster = item.poster ? safeSitePath(item.poster) : undefined;
      return {
        type: "video",
        src,
        ...(srcMp4 ? { srcMp4 } : {}),
        ...(poster ? { poster } : {}),
        alt: item.alt,
      };
    }
    const thumb = safeSitePath(thumbPath(src)) ?? src;
    return { type: "image", src, thumb, alt: item.alt };
  })
  .filter((item): item is PreviewItem => item !== null);

const hasImageLightbox = previews.some((item) => item.type === "image");
const imagePreviews = previews.filter(
  (item): item is PreviewImage => item.type === "image",
);
const otherPreviews = previews.filter((item) => item.type !== "image");

const sectionLabel =
  data.section === "tool-helper" ? "Tool Helper" : data.section === "ai" ? "Applied AI" : "Selected Work";
const isPhonePreview = data.section === "tool-helper";
const previewImgClass = isPhonePreview
  ? "mx-auto h-auto w-full max-w-[16rem] rounded-md border border-line sm:mx-0 sm:max-w-[18rem]"
  : "h-auto w-full max-w-3xl rounded-md border border-line";
const previewVideoClass = isPhonePreview
  ? "mx-auto h-auto w-full max-w-[16rem] rounded-md border border-line bg-ink/5 sm:mx-0 sm:max-w-[18rem]"
  : "h-auto w-full max-w-3xl rounded-md border border-line bg-ink/5";
const previewListClass =
  isPhonePreview && imagePreviews.length > 1
    ? "mt-6 grid gap-6 sm:grid-cols-2 sm:gap-8"
    : "mt-6 space-y-6";

const pageTitle = `${data.title} · ${site.name}`;
const backHref = data.section === "ai" ? "/#ai-projects" : "/#projects";
---

<BaseLayout title={pageTitle} description={data.outcome}>
  <header class="sticky top-0 z-40 border-b border-line bg-mist">
    <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-3 px-5 md:px-6">
      <a href="/#home" class="font-display text-sm font-semibold text-ink no-underline hover:text-accent">{site.name}</a>
      <a href={backHref} class="inline-flex min-h-11 items-center text-sm text-muted no-underline hover:text-accent">← Projects</a>
    </div>
  </header>

  <main id="main" class="mx-auto max-w-6xl px-5 py-12 md:px-6 md:py-20">
    <p class="text-sm text-muted">{sectionLabel}</p>
    <div class="mt-5 flex flex-col gap-8 md:flex-row md:items-start md:gap-12">
      {
        imageSrc && (
          <div class="size-28 shrink-0 overflow-hidden rounded-md border border-line bg-mist sm:size-32">
            <img
              src={imageSrc}
              alt={data.imageAlt}
              width="128"
              height="128"
              fetchpriority="high"
              decoding="async"
              class="size-full object-cover"
            />
          </div>
        )
      }
      <div class="min-w-0 flex-1">
        <h1 class="text-3xl leading-tight sm:text-4xl md:text-5xl">{data.title}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{data.outcome}</p>
        <dl class="mt-8 grid max-w-2xl gap-4 border-y border-line py-5 sm:grid-cols-2">
          <div><dt class="font-mono text-[10px] tracking-widest text-muted">TYPE</dt><dd class="mt-1 text-sm text-ink">{data.client} · {data.domain}</dd></div>
          <div><dt class="font-mono text-[10px] tracking-widest text-muted">STACK / CAPABILITIES</dt><dd class="mt-1 text-sm leading-relaxed text-ink">{data.stack.join(" · ")}</dd></div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-5 font-display text-sm">
          {
            live && (
              <a
                href={live}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center text-accent no-underline hover:underline"
              >
                Live demo ↗
              </a>
            )
          }
          {
            repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center text-accent no-underline hover:underline"
              >
                Code ↗
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="mt-16 grid gap-12 border-t border-line pt-12 md:grid-cols-[13rem_1fr] md:gap-16">
      <p class="font-mono text-[11px] tracking-widest text-accent">PROJECT NOTES</p>
      <div class="max-w-3xl space-y-10">
        <section>
          <h2 class="font-display text-2xl">Overview</h2>
          <p class="mt-3 leading-relaxed text-muted">{data.what}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl">Problem</h2>
          <p class="mt-3 leading-relaxed text-muted">{data.why}</p>
        </section>
        <section>
          <h2 class="font-display text-2xl">Approach</h2>
          <p class="mt-3 leading-relaxed text-muted">{data.how}</p>
        </section>
      </div>
    </div>

    {
      previews.length > 0 && (
        <section class="mt-16 border-t border-line pt-12">
          <p class="font-mono text-[11px] tracking-widest text-accent">LIVE PRODUCT PREVIEW</p>
          <h2 class="mt-2 font-display text-xl">
            {otherPreviews.some((item) => item.type === "video")
              ? "Interactive demo"
              : otherPreviews.some((item) => item.type === "embed")
                ? "Interactive UI"
                : "Product UI"}
          </h2>
          <ul class={previewListClass}>
            {otherPreviews.map((item) =>
              item.type === "embed" ? (
                <li class="max-w-3xl">
                  <div class="overflow-hidden rounded-lg border border-line bg-surface">
                    <div class="relative aspect-[16/10] w-full bg-ink/5">
                      <iframe
                        src={item.src}
                        title={item.title}
                        class="absolute inset-0 h-full w-full border-0"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allow="clipboard-write"
                        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
                      />
                    </div>
                  </div>
                  <p class="mt-3 text-sm text-muted">
                    Interactive live UI — use the demo inside the frame, or open{" "}
                    {live ? (
                      <a
                        href={live}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-accent no-underline hover:underline"
                      >
                        Live
                      </a>
                    ) : (
                      "Live"
                    )}{" "}
                    in a new tab.
                  </p>
                </li>
              ) : item.type === "video" ? (
                <li>
                  <video
                    class={previewVideoClass}
                    data-autoplay-demo
                    autoplay
                    controls
                    muted
                    loop
                    playsinline
                    preload="auto"
                    poster={item.poster}
                    aria-label={item.alt}
                  >
                    <source src={item.src} type="video/webm" />
                    {item.srcMp4 && (
                      <source src={item.srcMp4} type="video/mp4" />
                    )}
                  </video>
                </li>
              ) : null,
            )}
            {imagePreviews.map((item) => (
              <li>
                <button
                  type="button"
                  class="group block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left"
                  data-preview-open
                  data-preview-src={item.src}
                  data-preview-alt={item.alt}
                  aria-label={`Enlarge preview: ${item.alt}`}
                >
                  <img
                    src={item.thumb}
                    alt={item.alt}
                    width={data.section === "ai" ? 1200 : 540}
                    height={data.section === "ai" ? 794 : 810}
                    class={`${previewImgClass} transition group-hover:opacity-90`}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>

  {
    hasImageLightbox && (
      <>
        <dialog
          id="preview-lightbox"
          class="preview-lightbox m-0 border-0 bg-transparent p-0"
          aria-label="Preview image"
        >
          <div
            id="preview-lightbox-stage"
            class="flex max-h-[85vh] max-w-[min(92vw,1100px)] items-center justify-center"
          >
            <img
              id="preview-lightbox-img"
              src=""
              alt=""
              class="max-h-[85vh] w-auto max-w-full rounded-md object-contain"
            />
          </div>
        </dialog>

        <style>
          #preview-lightbox.preview-lightbox {
            position: fixed;
            inset: 0;
            width: 100vw;
            max-width: none;
            height: 100dvh;
            max-height: none;
            margin: 0;
            padding: 1.5rem;
            background: transparent;
          }

          #preview-lightbox[open] {
            display: grid;
            place-items: center;
          }

          #preview-lightbox::backdrop {
            background: rgb(24 38 56 / 0.45);
          }
        </style>
      </>
    )
  }

  <script>
    let abort: AbortController | null = null;

    function initProjectDetailInteractions() {
      abort?.abort();
      abort = new AbortController();
      const { signal } = abort;

      document.querySelectorAll<HTMLVideoElement>("[data-autoplay-demo]").forEach(
        (video) => {
          const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;
          if (reduce) {
            video.removeAttribute("autoplay");
            video.pause();
            video.currentTime = 0;
            return;
          }
          video.muted = true;
          video.playsInline = true;
          const play = () => {
            void video.play().catch(() => {
              /* Autoplay may still be blocked; controls remain. */
            });
          };
          if (video.readyState >= 2) play();
          else video.addEventListener("loadeddata", play, { once: true, signal });
        },
      );

      const dialog = document.getElementById("preview-lightbox");
      const img = document.getElementById("preview-lightbox-img");
      if (
        !(dialog instanceof HTMLDialogElement) ||
        !(img instanceof HTMLImageElement)
      ) {
        return;
      }

      document.querySelectorAll("[data-preview-open]").forEach((btn) => {
        if (!(btn instanceof HTMLButtonElement)) return;
        btn.addEventListener(
          "click",
          () => {
            const src = btn.dataset.previewSrc;
            const alt = btn.dataset.previewAlt ?? "";
            if (!src || !src.startsWith("/") || src.startsWith("//")) return;
            img.src = src;
            img.alt = alt;
            dialog.showModal();
          },
          { signal },
        );
      });

      dialog.addEventListener(
        "click",
        (event) => {
          if (event.target === dialog) dialog.close();
        },
        { signal },
      );

      dialog.addEventListener(
        "close",
        () => {
          img.removeAttribute("src");
          img.alt = "";
        },
        { signal },
      );
    }

    document.addEventListener("astro:page-load", initProjectDetailInteractions);
  </script>

  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-8 md:px-6"
    >
      <a
        href="/#home"
        class="font-display text-sm text-muted no-underline hover:text-ink"
      >
        {site.name}
      </a>
      <a
        href={backHref}
        class="inline-flex min-h-11 items-center text-sm text-accent no-underline hover:underline"
      >
        Back to projects
      </a>
    </div>
  </footer>
</BaseLayout>
