---
import type { CollectionEntry } from "astro:content";
import { safeExternalUrl, safeSitePath } from "../data/site";

interface Props {
  id: string;
  label: string;
  projects: CollectionEntry<"projects">[];
}

const { id, label, projects } = Astro.props;
const trackId = `${id}-track`;
---

<div data-project-slider class="project-slider" role="region" aria-label={label}>
  <div class="mb-5 flex items-center justify-between gap-4">
    <p class="text-sm text-muted">{projects.length} projects <span data-slider-hint><span aria-hidden="true">·</span> Scroll to explore</span></p>
    <div data-slider-controls class="hidden items-center gap-2">
      <button type="button" data-slider-prev aria-label={`Previous ${label.toLowerCase()}`} aria-controls={trackId} class="slider-arrow" disabled><span aria-hidden="true">←</span></button>
      <button type="button" data-slider-next aria-label={`Next ${label.toLowerCase()}`} aria-controls={trackId} class="slider-arrow"><span aria-hidden="true">→</span></button>
    </div>
  </div>
  <ul id={trackId} data-slider-track class="project-track" tabindex="0" aria-label={`${label}. Use left and right arrow keys to browse.`}>
    {projects.map(({ id: slug, data }) => {
      const preview = data.previews?.find((item) => item.type === "image");
      const video = data.previews?.find((item) => item.type === "video");
      const poster = video?.type === "video" ? video.poster : undefined;
      const media = data.showcase?.src ?? (preview?.type === "image" ? preview.src : poster ?? data.image);
      const image = media ? safeSitePath(media) : null;
      const alt = data.showcase?.alt ?? (preview?.type === "image" ? preview.alt : poster && video?.type === "video" ? video.alt : data.imageAlt);
      const logo = !data.showcase && !preview && !poster;
      const live = data.links?.live ? safeExternalUrl(data.links.live) : null;
      const repo = data.links?.repo ? safeExternalUrl(data.links.repo) : null;
      const detail = `/projects/${slug}`;
      return (
        <li data-project-card class="project-card">
          <a href={detail} draggable="false" class:list={["project-media", { "is-logo": logo }]} style={`--focus-x: ${data.showcase?.focusX ?? 50}%; --focus-y: ${data.showcase?.focusY ?? 50}%`} aria-label={`View ${data.title}`}>
            {image && <img src={image} alt={alt} width="1200" height="800" draggable="false" loading="lazy" decoding="async" />}
          </a>
          <div class="project-heading">
            <p class="text-xs leading-relaxed text-muted">{data.domain}</p>
            <h3 class="project-title"><a href={detail} draggable="false" class="transition-colors hover:text-accent">{data.title}</a></h3>
          </div>
          <div class="project-copy">
            <p class="text-sm leading-relaxed text-muted">{data.summary ?? data.outcome}</p>
            {data.showcase?.caption && <p class="mt-2 text-xs text-muted">{data.showcase.caption}</p>}
          </div>
          <div class="project-actions text-sm">
            <a href={detail} draggable="false" class="text-accent hover:underline">Details <span class="ml-1 motion-arrow" aria-hidden="true">→</span></a>
            {image && <a href={image} draggable="false" data-original-preview target="_blank" rel="noopener noreferrer" aria-label={`Preview ${data.title} image (opens in a new tab)`} class="text-muted hover:text-ink">Preview ↗</a>}
            {live && <a href={live} draggable="false" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-ink">Live demo ↗</a>}
            {repo && <a href={repo} draggable="false" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-ink">Code ↗</a>}
          </div>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .project-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 88%;
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line) transparent;
    padding: 6px 4px 16px;
    scroll-padding-inline: 4px;
  }
  .project-track.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .project-track.is-dragging a { cursor: grabbing; }
  .project-card {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    gap: 12px;
    padding: 16px;
    min-width: 0;
    scroll-snap-align: start;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: var(--color-surface);
    transition: border-color 180ms ease, transform 180ms ease;
  }
  .project-media {
    position: relative;
    display: block;
    width: 96px;
    height: 72px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-mist);
  }
  .project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus-x) var(--focus-y);
    transform: scale(1.15);
    transform-origin: var(--focus-x) var(--focus-y);
  }
  .project-media.is-logo img { object-fit: contain; transform: none; padding: 6px; }
  .project-media:focus-visible { outline-offset: -4px; }
  .project-heading { min-width: 0; }
  .project-title { margin-top: 4px; font-size: 18px; line-height: 1.3; overflow-wrap: anywhere; }
  .project-copy, .project-actions { grid-column: 1 / -1; }
  .project-actions { display: flex; align-items: end; flex-wrap: wrap; gap: 0 16px; }
  .project-actions a { display: inline-flex; min-height: 44px; align-items: center; }
  .slider-arrow {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    font-size: 20px;
    transition: border-color 180ms ease;
  }
  .slider-arrow span { display: inline-block; transition: transform 180ms ease; }
  .slider-arrow:disabled { opacity: 0.35; cursor: default; }
  @media (hover: hover) and (pointer: fine) {
    .project-track { cursor: grab; }
    .project-card:hover { border-color: var(--color-accent); transform: translateY(-4px); }
    .slider-arrow:hover:not(:disabled) { border-color: var(--color-accent); }
    [data-slider-prev]:hover:not(:disabled) span { transform: translateX(-2px); }
    [data-slider-next]:hover:not(:disabled) span { transform: translateX(2px); }
  }
  @media (min-width: 640px) {
    .project-track { grid-auto-columns: 56%; }
    .project-card { grid-template-columns: minmax(0, 1fr); grid-template-rows: 200px auto 1fr auto; gap: 0; padding: 0; }
    .project-media { width: 100%; height: 200px; border: 0; border-bottom: 1px solid var(--color-line); border-radius: 8px 8px 0 0; }
    .project-heading { padding: 16px 20px 0; }
    .project-title { font-size: 22px; }
    .project-copy { padding: 12px 20px 0; }
    .project-actions { padding: 12px 20px 16px; }
  }
  @media (min-width: 1024px) { .project-track { grid-auto-columns: 46%; } }
  @media (prefers-reduced-motion: reduce) {
    .project-card:hover, .slider-arrow:hover span { transform: none; }
  }
</style>

<script>
  let abort: AbortController | null = null;

  function initProjectSliders() {
    abort?.abort();
    abort = new AbortController();
    const { signal } = abort;

    document.querySelectorAll<HTMLElement>("[data-project-slider]").forEach((slider) => {
      const track = slider.querySelector<HTMLElement>("[data-slider-track]");
      const controls = slider.querySelector<HTMLElement>("[data-slider-controls]");
      const hint = slider.querySelector<HTMLElement>("[data-slider-hint]");
      const previous = slider.querySelector<HTMLButtonElement>("[data-slider-prev]");
      const next = slider.querySelector<HTMLButtonElement>("[data-slider-next]");
      if (!track || !controls || !previous || !next) return;

      let targetLeft: number | null = null;
      let drag: { id: number; x: number; y: number; left: number; active: boolean } | null = null;
      let suppressClick = false;
      const resetTarget = () => { targetLeft = null; };
      const finishDrag = () => {
        const pointer = drag;
        drag = null;
        track.classList.remove("is-dragging");
        if (pointer && track.hasPointerCapture(pointer.id)) track.releasePointerCapture(pointer.id);
        resetTarget();
      };
      const sync = () => {
        const max = track.scrollWidth - track.clientWidth;
        controls.classList.toggle("hidden", max <= 1);
        controls.classList.toggle("flex", max > 1);
        hint?.classList.toggle("hidden", max <= 1);
        previous.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft >= max - 1;
      };
      const move = (direction: number) => {
        const cards = track.querySelectorAll<HTMLElement>("[data-project-card]");
        if (cards.length < 2) return;
        const step = cards[1].offsetLeft - cards[0].offsetLeft;
        const index = Math.round((targetLeft ?? track.scrollLeft) / step);
        targetLeft = Math.max(0, Math.min((index + direction) * step, track.scrollWidth - track.clientWidth));
        track.scrollTo({
          left: targetLeft,
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        });
      };

      previous.addEventListener("click", () => move(-1), { signal });
      next.addEventListener("click", () => move(1), { signal });
      track.addEventListener("scroll", sync, { passive: true, signal });
      for (const event of ["scrollend", "focusin"]) {
        track.addEventListener(event, resetTarget, { passive: true, signal });
      }
      track.addEventListener("wheel", finishDrag, { passive: true, signal });
      track.addEventListener("pointerdown", (event) => {
        finishDrag();
        suppressClick = false;
        if (event.pointerType !== "mouse" || event.button !== 0 || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        drag = { id: event.pointerId, x: event.clientX, y: event.clientY, left: track.scrollLeft, active: false };
      }, { signal });
      track.addEventListener("pointermove", (event) => {
        if (!drag || drag.id !== event.pointerId) return;
        const dx = event.clientX - drag.x;
        const dy = event.clientY - drag.y;
        if (!drag.active) {
          if (Math.abs(dy) > 8 && Math.abs(dy) > Math.abs(dx)) { finishDrag(); return; }
          if (Math.abs(dx) <= 8) return;
          drag.active = true;
          suppressClick = true;
          track.setPointerCapture(event.pointerId);
          track.classList.add("is-dragging");
        }
        event.preventDefault();
        track.scrollLeft = drag.left - dx;
      }, { signal });
      for (const event of ["pointerup", "pointercancel", "lostpointercapture"]) {
        track.addEventListener(event, finishDrag, { signal });
      }
      track.addEventListener("click", (event) => {
        if (!suppressClick) return;
        suppressClick = false;
        event.preventDefault();
        event.stopPropagation();
      }, { capture: true, signal });
      track.addEventListener("keydown", (event) => {
        if (event.target !== track || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        move(event.key === "ArrowRight" ? 1 : -1);
      }, { signal });
      const resize = new ResizeObserver(() => { finishDrag(); sync(); });
      resize.observe(track);
      signal.addEventListener("abort", () => { finishDrag(); resize.disconnect(); }, { once: true });
      sync();
    });
  }

  document.addEventListener("astro:before-swap", () => abort?.abort());
  document.addEventListener("astro:page-load", initProjectSliders);
</script>
