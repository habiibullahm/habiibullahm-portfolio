---
import { nav, site } from "../data/site";

const onHome = Astro.url.pathname === "/";
const homeHref = onHome ? "#home" : "/#home";
---

<header id="site-header" class="fixed left-1/2 top-4 z-40 w-[calc(100%-2rem)] max-w-[420px] -translate-x-1/2 rounded-sm border border-line bg-mist md:top-6">
  <div class="relative flex min-h-16 items-center justify-between gap-3 px-4">
    <a href={homeHref} data-nav-home class="font-display text-sm font-semibold text-ink no-underline hover:text-accent" aria-label={`${site.name} — home`}>
      {site.name}
    </a>
    <button type="button" id="nav-toggle" class="inline-flex size-11 shrink-0 items-center justify-center text-ink transition-opacity duration-300 hover:opacity-70" aria-controls="primary-nav" aria-expanded="false" aria-label="Open menu">
      <svg id="nav-icon-open" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path></svg>
      <svg id="nav-icon-close" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path></svg>
    </button>
    <nav id="primary-nav" aria-label="Primary" inert class="absolute inset-x-0 top-[calc(100%+0.5rem)] hidden rounded-sm border border-line bg-mist p-3">
      <ul class="flex flex-col gap-1">
        {nav.map((item) => (
          <li>
            <a href={`${onHome ? "" : "/"}#${item.id}`} data-nav-link={item.id} class="block rounded-sm min-h-11 px-3 py-3 font-body text-sm text-muted no-underline transition-colors hover:text-ink">
              {item.label}
            </a>
          </li>
        ))}
        <li><a href="/resume" class="block rounded-sm border border-line min-h-11 px-3 py-3 text-sm text-ink no-underline hover:border-accent">Resume</a></li>
      </ul>
    </nav>

  </div>
  <noscript>
    <nav aria-label="Primary" class="flex flex-wrap gap-x-4 border-t border-line px-4 py-3 text-sm">
      {nav.map(item => <a href={`${onHome ? "" : "/"}#${item.id}`} class="text-link">{item.label}</a>)}
      <a href="/resume" class="text-link">Resume</a>
    </nav>
    <style is:inline>#nav-toggle { display: none; } #site-header { position: static; transform: none; margin: 16px auto; } #home .hero-content { padding-top: 64px; }</style>
  </noscript>
</header>

<script>
  let abort: AbortController | null = null;

  function initHeaderNav() {
    abort?.abort();
    const toggle = document.getElementById("nav-toggle");
    const navigation = document.getElementById("primary-nav");
    const iconOpen = document.getElementById("nav-icon-open");
    const iconClose = document.getElementById("nav-icon-close");
    if (!toggle || !navigation || !iconOpen || !iconClose) return;
    abort = new AbortController();
    const { signal } = abort;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let open = false;
    let animation: Animation | null = null;
    const settle = () => {
      animation?.cancel();
      animation = null;
      navigation.classList.toggle("hidden", !open);
    };

    const setOpen = (nextOpen: boolean) => {
      if (nextOpen === open) return;
      open = nextOpen;
      animation?.cancel();
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      navigation.inert = !open;
      navigation.classList.remove("hidden");
      iconOpen.classList.toggle("hidden", open);
      iconClose.classList.toggle("hidden", !open);
      document.dispatchEvent(new CustomEvent("nav-menu-toggle", { detail: { open } }));
      if (reduce.matches) { settle(); return; }
      const frames = [{ opacity: 0, transform: "translateY(-6px)" }, { opacity: 1, transform: "none" }];
      animation = navigation.animate(open ? frames : frames.reverse(), { duration: 180, easing: "cubic-bezier(0.22, 1, 0.36, 1)" });
      animation.onfinish = () => { navigation.classList.toggle("hidden", !open); animation = null; };
    };

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"), { signal });
    navigation.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false), { signal });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    }, { signal });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !navigation.contains(event.target) && !toggle.contains(event.target)) setOpen(false);
    }, { signal });
    navigation.addEventListener("focusin", settle, { signal });
    reduce.addEventListener("change", () => { if (reduce.matches) settle(); }, { signal });
    window.addEventListener("beforeprint", () => { setOpen(false); settle(); }, { signal });
    signal.addEventListener("abort", settle, { once: true });
  }

  document.addEventListener("astro:page-load", initHeaderNav);
  document.addEventListener("astro:before-swap", () => abort?.abort());
</script>
