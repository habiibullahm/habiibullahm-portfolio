---
import { getCollection } from "astro:content";
import ProjectSlider from "../ProjectSlider.astro";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft && project.data.section === "ai")
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="ai-projects" data-section class="section-anchor border-b border-line" aria-labelledby="ai-heading">
  <div class="portfolio-section">
    <h2 id="ai-heading" class="text-3xl md:text-4xl">AI projects</h2>
    <p class="mb-8 mt-3 text-muted">Assistants for business information and product discovery.</p>
    <ProjectSlider id="ai-projects" label="AI projects" projects={projects} />
  </div>
</section>