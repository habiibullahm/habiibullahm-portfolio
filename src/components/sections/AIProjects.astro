---
import { getCollection } from "astro:content";
import ProjectIndex from "../ProjectIndex.astro";
import { selectedProjectIds as selected } from "../../data/site";
const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft && selected.includes(project.id))
  .sort((a, b) => selected.indexOf(a.id) - selected.indexOf(b.id));
---
<section id="projects" data-section class="section-anchor" aria-labelledby="work-heading">
  <div class="portfolio-section">
    <div class="section-heading">
      <span class="section-rule" data-line-reveal="work-line" aria-hidden="true"></span>
      <p class="section-kicker">01 / Selected Work</p>
      <div data-reveal="work-heading"><h2 id="work-heading" class="section-title">Practical systems.<br />Real-world problems.</h2><p class="mt-5 max-w-lg text-muted">Assistants for business information and product discovery. Applications built around everyday tasks.</p></div>
    </div>
    <ProjectIndex projects={projects} showcase />
  </div>
</section>
