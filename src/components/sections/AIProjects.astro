---
import { getCollection } from "astro:content";
import { safeExternalUrl, safeSitePath } from "../../data/site";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft && project.data.section === "ai")
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="ai-projects" data-section class="section-anchor border-b border-line">
  <div class="portfolio-section" data-reveal>
    <p class="font-mono text-[11px] tracking-widest text-accent">01 / APPLIED AI</p>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-3xl font-semibold tracking-tight md:text-4xl">Selected AI projects</h2>
      <p class="max-w-sm text-sm text-muted">Business information and product discovery, built as deployed assistants.</p>
    </div>
    <ul class="mt-10 grid gap-8 lg:grid-cols-2 lg:gap-6">
      {projects.map((project, index) => {
        const live = project.data.links?.live ? safeExternalUrl(project.data.links.live) : null;
        const preview = project.data.previews?.find((item) => item.type === "image");
        const image = preview?.type === "image" ? safeSitePath(preview.src) : null;
        const detail = `/projects/${project.id}`;

        return (
          <li class="group min-w-0 border border-line p-4 transition-colors duration-300 hover:border-accent md:p-5">
            <a href={detail} class="block overflow-hidden no-underline focus-visible:outline-accent">
              {image ? <img src={image} alt={preview?.type === "image" ? preview.alt : ""} width="1200" height="800" loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.015] motion-reduce:transition-none" /> : <div class="aspect-[3/2]" aria-hidden="true"></div>}
            </a>
            <div class="mt-5 flex items-start gap-4">
              <p class="pt-1 font-mono text-xs text-accent">{String(index + 1).padStart(2, "0")}</p>
              <div class="min-w-0 flex-1">
                <p class="font-mono text-[11px] tracking-widest text-muted">{project.data.client.toUpperCase()} · {project.data.domain.toUpperCase()}</p>
                <h3 class="mt-2 font-display text-2xl font-semibold tracking-tight sm:text-3xl">
                  <a href={detail} class="text-ink no-underline transition-colors hover:text-accent">{project.data.title}</a>
                </h3>
                <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">{project.data.outcome}</p>
                <p class="mt-4 font-mono text-[10px] leading-6 text-muted">{project.data.stack.join(" · ")}</p>
                <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                  <a href={detail} class="inline-flex min-h-11 items-center text-accent underline-offset-4 hover:underline">View case study →</a>
                  {live && <a href={live} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-muted underline-offset-4 hover:text-accent hover:underline">Live demo ↗</a>}
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>
