---
import { safeExternalUrl, site } from "../../data/site";
const aiServices = safeExternalUrl(site.aiServicesUrl);
---

<section id="home" data-section class="section-anchor" aria-labelledby="hero-heading">
  <div class="portfolio-section hero-content grid items-center gap-10 md:grid-cols-[1fr_280px] md:gap-16">
    <div>
      <p class="text-sm text-muted">Habib · Jakarta, Indonesia</p>
      <h1 id="hero-heading" class="mt-4 max-w-2xl text-[clamp(2.5rem,5vw,4rem)] leading-[1.12]">AI &amp; Full-Stack Engineer<span class="text-accent">.</span></h1>
      <p class="mt-5 max-w-lg text-lg text-muted">{site.tagline}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="#ai-projects" class="motion-cta inline-flex min-h-11 items-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-mist hover:bg-ink">View projects <span class="ml-2 motion-arrow motion-arrow-down" aria-hidden="true">↓</span></a>
        <a href="/resume" class="motion-cta inline-flex min-h-11 items-center rounded-lg border border-line px-5 py-3 text-sm hover:border-accent">Resume</a>
      </div>
      {aiServices && <a href={aiServices} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-11 items-center text-sm text-muted hover:text-accent">AI Services ↗</a>}
    </div>
    <img src="/images/habib-profile.webp" alt="Muhammad Habiibullah" width="480" height="480" fetchpriority="high" class="aspect-square w-full max-w-[280px] rounded-lg border border-line object-cover" />
  </div>
</section>

<style>
  .hero-content { padding-top: 144px; padding-bottom: 64px; }
  @media (min-width: 768px) { .hero-content { padding-top: 176px; padding-bottom: 80px; } }
</style>