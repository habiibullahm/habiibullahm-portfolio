---
import { nav, safeExternalUrl, site } from "../../data/site";

const heroNav = nav;
const aiServices = safeExternalUrl(site.aiServicesUrl);
---

<section
  id="home"
  data-section
  class="section-anchor relative overflow-hidden border-b border-line"
>
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-6 md:px-6 md:pb-24 md:pt-8">
    <div class="flex items-center justify-between gap-3">
      <p class="min-w-0 font-display text-sm font-semibold text-ink">
        {site.name}
      </p>

      <nav
        id="hero-nav"
        aria-label="Sections"
        class="hidden shrink-0 md:block"
      >
        <ul class="flex items-center gap-3">
          {
            heroNav.map((item) => (
              <li>
                <a
                  href={`#${item.id}`}
                  data-nav-link={item.id}
                  title={item.label}
                  class="font-display text-[11px] font-medium tracking-wide text-muted no-underline transition-colors hover:text-ink"
                >
                  {item.short}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p
      class="hero-animate mt-12 font-mono text-xs tracking-widest text-accent md:mt-20"
    >
      {site.eyebrow}
    </p>
    <h1
      class="hero-animate hero-animate-delay-1 mt-4 max-w-4xl font-display text-4xl font-semibold leading-tight text-ink sm:text-5xl md:text-6xl"
    >
      {site.statement}
    </h1>
    <p
      class="hero-animate hero-animate-delay-2 mt-5 max-w-2xl text-base text-muted md:text-lg"
    >
      {site.summary}
    </p>
    <p class="hero-animate hero-animate-delay-2 mt-5 max-w-3xl font-mono text-xs leading-6 text-muted">
      {site.technologies}
    </p>
    <div class="hero-animate hero-animate-delay-3 mt-8 flex flex-wrap gap-3">
      <a
        href="#ai-projects"
        class="inline-flex items-center rounded-md bg-ink px-5 py-3 font-display text-sm font-medium text-white no-underline transition hover:bg-ink/90"
      >
        View my work
      </a>
      <a
        href="/resume"
        class="inline-flex items-center rounded-md border border-ink/20 bg-transparent px-5 py-3 font-display text-sm font-medium text-ink no-underline transition hover:border-accent hover:text-accent"
      >
        View resume
      </a>
      {
        aiServices && (
          <a
            href={aiServices}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-md px-2 py-3 font-display text-sm font-medium text-muted no-underline transition hover:text-accent"
          >
            AI Services ↗
          </a>
        )
      }
    </div>
  </div>
</section>

<script>
  import "../../scripts/hero-replay.ts";
</script>
