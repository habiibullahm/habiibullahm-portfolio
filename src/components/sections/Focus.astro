---
import { focusAreas } from "../../data/site";
---

<section id="focus" class="section-anchor border-b border-line" aria-labelledby="focus-heading">
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-20">
  <p class="font-mono text-xs tracking-widest text-muted">ENGINEERING CAPABILITIES</p>
  <h2 id="focus-heading" class="mt-2 text-2xl md:text-3xl">
    From interface to infrastructure.
  </h2>
  <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      focusAreas.map((item) => (
        <li class="border-t border-line pt-6">
          <h3 class="text-lg text-ink">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{item.blurb}</p>
        </li>
      ))
    }
  </ul>
  </div>
</section>
