---
import { focusAreas, site } from "../../data/site";
---

<section id="focus" class="section-anchor border-b border-line" aria-labelledby="focus-heading">
  <div class="portfolio-section" data-reveal>
    <p class="font-mono text-[11px] tracking-widest text-accent">03 / CAPABILITIES</p>
    <div class="mt-3 grid gap-5 md:grid-cols-[1.4fr_0.8fr] md:items-end md:gap-12">
      <h2 id="focus-heading" class="text-3xl md:text-4xl">From interface to infrastructure.</h2>
      <p class="max-w-lg text-muted">{site.summary}</p>
    </div>
    <ul class="mt-10 divide-y divide-line border-y border-line">
      {focusAreas.map((item) => (
        <li class="grid gap-3 py-6 md:grid-cols-[minmax(14rem,0.9fr)_1.1fr] md:items-center md:gap-10">
          <h3 class="text-xl text-ink md:text-2xl">{item.title}</h3>
          <p class="max-w-2xl text-sm leading-relaxed text-muted">{item.blurb}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
