---
const capabilities = [
  { title: "Full-stack development", description: "React, TypeScript, and web applications." },
  { title: "Applied AI", description: "RAG, LLM integrations, and grounded assistants." },
  { title: "Backend & data", description: "Java, Spring Boot, Node.js, and PostgreSQL." },
];
---

<section id="focus" class="section-anchor border-b border-line" aria-labelledby="focus-heading">
  <div class="portfolio-section">
    <h2 id="focus-heading" class="text-3xl md:text-4xl">Capabilities</h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {capabilities.map(({ title, description }) => (
        <li>
          <h3 class="text-lg">{title}</h3>
          <p class="mt-2 text-sm text-muted">{description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>