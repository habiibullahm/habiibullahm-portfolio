---
import { focusAreas } from "../../data/site";
---
<section id="focus" class="section-anchor" aria-labelledby="focus-heading">
  <div class="portfolio-section">
    <div class="section-heading">
      <span class="section-rule" data-line-reveal="focus-line" aria-hidden="true"></span>
      <p class="section-kicker">02 / Capabilities</p>
      <h2 id="focus-heading" class="section-title" data-reveal="focus-heading">From interface<br />to infrastructure.</h2>
    </div>
    <ul>{focusAreas.map(item => <li class="index-row"><h3 class="text-xl">{item.title}</h3><p class="max-w-2xl text-muted">{item.blurb}</p></li>)}</ul>
  </div>
</section>
