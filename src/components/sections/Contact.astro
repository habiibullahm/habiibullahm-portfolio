---
import { safeExternalUrl, site } from "../../data/site";

const mailto = safeExternalUrl(`mailto:${site.email}`);
const linkedin = safeExternalUrl(site.socials.linkedin);
---

<section id="contact" data-section class="section-anchor" aria-labelledby="contact-heading">
  <div class="portfolio-section">
    <h2 id="contact-heading" class="text-3xl md:text-4xl">Have a project in mind?</h2>
    <p class="mt-3 text-muted">Let’s talk about AI and full-stack development.</p>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      {mailto && <a href={mailto} class="motion-cta inline-flex min-h-11 items-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-mist hover:bg-ink">Email me ↗</a>}
      {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" class="motion-cta inline-flex min-h-11 items-center rounded-lg border border-line px-5 py-3 text-sm hover:border-accent">LinkedIn ↗</a>}
    </div>
  </div>
</section>