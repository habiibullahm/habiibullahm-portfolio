---
import { safeExternalUrl, site } from "../../data/site";

const mailto = safeExternalUrl(`mailto:${site.email}`);
---

<section id="contact" data-section class="section-anchor">
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-8 md:px-6 md:pb-20 md:pt-10">
    <p class="font-mono text-xs tracking-widest text-muted">CONTACT</p>
    <h2 class="mt-2 text-3xl md:text-4xl">Let's build something useful.</h2>
    <p class="mt-4 max-w-xl text-muted">{site.contactBlurb}</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      {
        mailto && (
          <a
            href={mailto}
            class="inline-flex items-center rounded-md bg-ink px-5 py-3 font-display text-sm font-medium text-white no-underline transition hover:bg-ink/90"
          >
            {site.email}
          </a>
        )
      }
    </div>
    <div class="mt-5 flex gap-6 font-display text-sm">
      <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" class="text-accent underline-offset-4 hover:underline">LinkedIn ↗</a>
      <a href={site.socials.github} target="_blank" rel="noopener noreferrer" class="text-accent underline-offset-4 hover:underline">GitHub ↗</a>
    </div>
  </div>
</section>
