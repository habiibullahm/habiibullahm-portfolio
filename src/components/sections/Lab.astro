---
import LabCollection from "../LabCollection.astro";
import { getLabEntries } from "../../data/lab";

const entries = await getLabEntries();
---
<section id="lab" data-section class="section-anchor" aria-labelledby="lab-heading">
  <div class="portfolio-section">
    <div class="section-heading">
      <span class="section-rule" data-line-reveal="lab-line" aria-hidden="true"></span>
      <p class="section-kicker">03 / Lab</p>
      <div data-reveal="lab-heading">
        <h2 id="lab-heading" class="section-title">Learning in<br />the open.</h2>
        <p class="mt-5 max-w-lg text-muted">Technical case studies, experiments, and architectural decisions from real engineering challenges.</p>
      </div>
    </div>
    <LabCollection entries={entries} limited />
  </div>
</section>
