---
import { contributions, education, safeExternalUrl } from "../../data/site";
---

<section id="about" data-section class="section-anchor border-b border-line" aria-labelledby="about-heading">
  <div class="portfolio-section">
    <h2 id="about-heading" class="text-3xl md:text-4xl">About</h2>
    <div class="mt-5 max-w-2xl space-y-4 text-muted">
      <p>I'm Habib, a Jakarta-based engineer at PT. Dans Multi Pro. I build enterprise applications and explore practical uses of AI.</p>
      <p>I enjoy turning real needs into useful software, from the interface and APIs to data and deployment.</p>
    </div>
    <dl class="mt-8 max-w-2xl space-y-5 border-t border-line pt-6 text-sm">
      <div>
        <dt class="font-semibold">Education</dt>
        {education.map((item) => <dd class="mt-1 text-muted">{item.title}<br />{item.org}</dd>)}
      </div>
      <div id="contributions" class="section-anchor" data-section>
        <dt class="font-semibold">Open source</dt>
        {contributions.map((item) => {
          const href = safeExternalUrl(item.href);
          return <dd class="mt-1 text-muted">{item.title} · Pipedream{href && <a href={href} target="_blank" rel="noopener noreferrer" class="ml-3 inline-flex min-h-11 items-center text-accent hover:underline">View merged PR ↗</a>}</dd>;
        })}
      </div>
    </dl>
  </div>
</section>