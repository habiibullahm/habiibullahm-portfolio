---
import { education, site } from "../../data/site";
---
<section id="about" data-section class="section-anchor" aria-labelledby="about-heading">
  <div class="portfolio-section">
    <div class="section-heading">
      <span class="section-rule" data-line-reveal="about-line" aria-hidden="true"></span>
      <p class="section-kicker">04 / About</p>
      <h2 id="about-heading" class="section-title" data-reveal="about-heading">Product-minded<br />engineering.</h2>
    </div>
    <div class="index-row"><p class="text-sm text-muted">Muhammad Habiibullah<br />Jakarta, Indonesia</p><div class="max-w-2xl space-y-5 text-muted">{site.about.paragraphs.map(paragraph => <p>{paragraph}</p>)}<div class="border-t border-line pt-6"><h3 class="mb-2 text-sm text-ink">Education</h3>{education.map(item => <p class="text-sm">{item.title}<br />{item.org}</p>)}</div></div></div>
  </div>
</section>
