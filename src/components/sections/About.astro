---
import { education, site } from "../../data/site";
---

<section id="about" data-section class="section-anchor border-b border-line">
  <div class="mx-auto max-w-6xl px-4 pb-16 pt-8 md:px-6 md:pb-20 md:pt-10">
    <p class="font-mono text-xs tracking-widest text-muted">ABOUT</p>
    <h2 class="mt-2 text-2xl md:text-3xl">{site.about.lead}</h2>

    <div class="mt-8 max-w-3xl space-y-5 text-muted">
      {site.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <p class="mt-14 font-mono text-xs tracking-widest text-muted">EDUCATION</p>
    <ul class="mt-6 space-y-8">
      {
        education.map((item) => (
          <li class="grid gap-2 border-t border-line pt-6 md:grid-cols-[1fr_auto]">
            <div>
              <h3 class="text-xl md:text-2xl">{item.title}</h3>
              <p class="mt-2 text-muted">{item.org}</p>
            </div>
            <p class="font-mono text-xs text-muted md:text-right">{item.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
