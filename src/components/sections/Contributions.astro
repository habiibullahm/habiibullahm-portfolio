---
import { contributions, safeExternalUrl } from "../../data/site";
---

<section
  id="contributions"
  data-section
  class="section-anchor border-b border-line"
>
  <div class="portfolio-section" data-reveal>
    <p class="font-mono text-[11px] tracking-widest text-accent">06 / OPEN SOURCE</p>
    <h2 class="mt-3 text-3xl md:text-4xl">Contributing beyond my own projects.</h2>

    <ul class="mt-10 space-y-8">
      {
        contributions.map((item) => {
          const href = safeExternalUrl(item.href);
          return (
            <li class="border-t border-line pt-6">
              <p class="font-mono text-xs tracking-wide text-muted">{item.org}</p>
              <h3 class="mt-2 text-xl md:text-2xl">{item.title}</h3>
              <p class="mt-3 max-w-3xl text-muted">{item.outcome}</p>
              {href && (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-block font-display text-sm text-accent no-underline hover:underline"
                >
                  View PR
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
