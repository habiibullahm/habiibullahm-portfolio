---
import { getCollection } from "astro:content";
import ProjectSlider from "../ProjectSlider.astro";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft && project.data.section !== "ai")
  .sort((a, b) => Number(a.data.section === "tool-helper") - Number(b.data.section === "tool-helper") || a.data.order - b.data.order);
---

<section id="projects" data-section class="section-anchor border-b border-line" aria-labelledby="projects-heading">
  <div class="portfolio-section">
    <h2 id="projects-heading" class="text-3xl md:text-4xl">Engineering &amp; tools</h2>
    <p class="mb-8 mt-3 text-muted">Web applications and automation built around everyday tasks.</p>
    <ProjectSlider id="projects" label="Engineering and tools" projects={projects} />
  </div>
</section>