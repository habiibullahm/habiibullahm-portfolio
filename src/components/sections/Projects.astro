---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { safeExternalUrl, safeSitePath } from "../../data/site";

const projects = (await getCollection("projects")).filter((p) => !p.data.draft);

const featured = projects
  .filter((p) => p.data.section === "featured")
  .sort((a, b) => a.data.order - b.data.order);

const toolHelpers = projects
  .filter((p) => p.data.section === "tool-helper")
  .sort((a, b) => a.data.order - b.data.order);

const thumbClass =
  "size-20 shrink-0 overflow-hidden rounded-md border border-line bg-mist";
const thumbImgClass = "size-full object-cover";

function projectLinks(project: CollectionEntry<"projects">) {
  const live = project.data.links?.live
    ? safeExternalUrl(project.data.links.live)
    : null;
  const repo = project.data.links?.repo
    ? safeExternalUrl(project.data.links.repo)
    : null;
  const imageSrc = project.data.image ? safeSitePath(project.data.image) : null;
  return { live, repo, imageSrc };
}
---

<section id="projects" data-section class="section-anchor border-b border-line">
  <div class="portfolio-section" data-reveal>
    <p class="font-mono text-[11px] tracking-widest text-accent">02 / ENGINEERING WORK</p>
    <h2 class="mt-3 text-3xl md:text-4xl">More systems, built and shipped.</h2>

    <ul class="mt-10 divide-y divide-line border-t border-line">
      {
        featured.map((project, index) => {
          const { live, repo, imageSrc } = projectLinks(project);
          return (
            <li class="grid gap-4 py-7 sm:grid-cols-[5rem_1fr] sm:items-start sm:gap-6">
              {imageSrc ? (
                <div class={thumbClass}>
                  <img
                    src={imageSrc}
                    alt={project.data.imageAlt}
                    width="128"
                    height="128"
                    class={thumbImgClass}
                    loading="lazy"
                  />
                </div>
              ) : null}
              <div>
                <p class="font-mono text-xs tracking-wide text-muted">
                  {project.data.client} · {project.data.domain}
                </p>
                <h3 class="mt-2 flex flex-wrap items-baseline gap-3 text-xl md:text-2xl">
                  <span class="font-mono text-xs text-accent">{String(index + 3).padStart(2, "0")} /</span>
                  <a
                    href={`/projects/${project.id}`}
                    class="text-ink no-underline hover:text-accent"
                  >
                    {project.data.title}
                  </a>
                </h3>
                {project.data.stack?.length ? (
                  <p class="mt-2 font-mono text-xs tracking-wide text-muted">
                    {project.data.stack.join(" · ")}
                  </p>
                ) : null}
                <p class="mt-3 max-w-3xl text-sm text-muted">{project.data.outcome}</p>
                <div class="mt-4 flex flex-wrap gap-4 font-display text-sm">
                  <a
                    href={`/projects/${project.id}`}
                    class="font-display text-sm text-accent no-underline hover:underline"
                  >
                    Details
                  </a>
                  {live && (
                    <a
                      href={live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-display text-sm text-accent no-underline hover:underline"
                    >
                      Live
                    </a>
                  )}
                  {repo && (
                    <a
                      href={repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-display text-sm text-accent no-underline hover:underline"
                    >
                      Code
                    </a>
                  )}
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    {
      toolHelpers.length > 0 && (
        <div class="mt-16 border-t border-line pt-12">
          <p class="font-mono text-[11px] tracking-widest text-accent">AUTOMATION & TOOLS</p>
          <h3 class="mt-2 font-display text-lg md:text-xl">
            Telegram bots for hiring, job search, and market signals
          </h3>
          <ul class="mt-8 space-y-10">
            {toolHelpers.map((project, index) => {
              const { live, repo, imageSrc } = projectLinks(project);
              return (
                <li class="grid gap-4 md:grid-cols-[8rem_1fr] md:items-start md:gap-6">
                  {imageSrc ? (
                    <div class={thumbClass}>
                      <img
                        src={imageSrc}
                        alt={project.data.imageAlt}
                        width="128"
                        height="128"
                        class={thumbImgClass}
                        loading="lazy"
                      />
                    </div>
                  ) : null}
                  <div>
                    <p class="font-mono text-xs tracking-wide text-muted">
                      {project.data.domain}
                    </p>
                    <h4 class="mt-1 flex flex-wrap items-baseline gap-3 text-lg md:text-xl">
                      <span class="font-mono text-xs text-accent">{String(index + featured.length + 3).padStart(2, "0")} /</span>
                      <a
                        href={`/projects/${project.id}`}
                        class="text-ink no-underline hover:text-accent"
                      >
                        {project.data.title}
                      </a>
                    </h4>
                    {project.data.stack?.length ? (
                      <p class="mt-1 font-mono text-xs tracking-wide text-muted">
                        {project.data.stack.join(" · ")}
                      </p>
                    ) : null}
                    <p class="mt-2 text-muted">{project.data.outcome}</p>
                    <div class="mt-3 flex flex-wrap gap-4 font-display text-sm">
                      <a
                        href={`/projects/${project.id}`}
                        class="text-accent no-underline hover:underline"
                      >
                        Details
                      </a>
                      {live && (
                        <a
                          href={live}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-accent no-underline hover:underline"
                        >
                          Live
                        </a>
                      )}
                      {repo && (
                        <a
                          href={repo}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-accent no-underline hover:underline"
                        >
                          Code
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      )
    }
  </div>
</section>
