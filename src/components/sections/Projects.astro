---
import ProjectCollection from "../ProjectCollection.astro";
import { getProjects } from "../../data/projects";
const projects = await getProjects();
---
<section id="projects" data-section class="section-anchor" aria-labelledby="projects-heading">
  <span id="ai-projects" class="section-anchor" aria-hidden="true"></span>
  <span id="engineering-projects" class="section-anchor" aria-hidden="true"></span>
  <span id="focus" class="section-anchor" aria-hidden="true"></span>
  <div class="portfolio-section">
    <div class="section-heading">
      <span class="section-rule" data-line-reveal="projects-line" aria-hidden="true"></span>
      <p class="section-kicker">01 / Projects</p>
      <div data-reveal="projects-heading"><h2 id="projects-heading" class="section-title">Projects</h2><p class="mt-5 max-w-lg text-muted">A collection of AI systems, web applications, and useful engineering tools.</p></div>
    </div>
    <ProjectCollection projects={projects} limited />
  </div>
</section>
