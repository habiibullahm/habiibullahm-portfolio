<button
  type="button"
  id="scroll-top"
  class="scroll-top pointer-events-none fixed bottom-6 right-4 z-30 inline-flex size-11 translate-y-2 items-center justify-center rounded-md border border-ink/15 bg-mist text-ink opacity-0 shadow-sm transition duration-200 hover:border-accent hover:text-accent focus-visible:opacity-100 md:right-6"
  aria-label="Kembali ke atas"
  data-label-id="Kembali ke atas"
  data-label-en="Back to top"
  aria-hidden="true"
  tabindex="-1"
>
  <svg
    class="size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path
      d="M12 19V5M5 12l7-7 7 7"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  .scroll-top.is-visible {
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  let abort: AbortController | null = null;
  let raf = 0;

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initScrollTop() {
    abort?.abort();
    if (raf) {
      cancelAnimationFrame(raf);
      raf = 0;
    }

    const button = document.getElementById("scroll-top");
    if (!button) return;

    const threshold = 400;
    const footerHidePx = 160;
    let menuOpen = false;
    let visible = false;

    abort = new AbortController();
    const { signal } = abort;

    const nearFooter = () => {
      const doc = document.documentElement;
      const remaining =
        doc.scrollHeight - (window.scrollY + window.innerHeight);
      return remaining < footerHidePx;
    };

    const applyVisibility = (show: boolean) => {
      if (show === visible) return;
      visible = show;
      button.classList.toggle("is-visible", show);
      button.setAttribute("aria-hidden", show ? "false" : "true");
      button.tabIndex = show ? 0 : -1;
    };

    const syncVisibility = () => {
      applyVisibility(window.scrollY > threshold && !menuOpen && !nearFooter());
    };

    const scheduleSync = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        syncVisibility();
      });
    };

    window.addEventListener("scroll", scheduleSync, { passive: true, signal });
    window.addEventListener("resize", scheduleSync, { passive: true, signal });
    document.addEventListener(
      "nav-menu-toggle",
      (event) => {
        menuOpen = Boolean(
          (event as CustomEvent<{ open?: boolean }>).detail?.open,
        );
        syncVisibility();
      },
      { signal },
    );

    button.addEventListener(
      "click",
      () => {
        document.dispatchEvent(new CustomEvent("scroll-to-top"));
        window.scrollTo({
          top: 0,
          behavior: prefersReducedMotion() ? "auto" : "smooth",
        });
      },
      { signal },
    );

    syncVisibility();
  }

  document.addEventListener("astro:page-load", initScrollTop);
</script>
