---
import type { CollectionEntry } from "astro:content";
import { labFilters, labHomeLimit } from "../data/lab";

interface Props {
  entries: CollectionEntry<"lab">[];
  limited?: boolean;
  headingTag?: "h2" | "h3";
}

const { entries, limited = false, headingTag: Heading = "h3" } = Astro.props;
const total = entries.length;
const filters = labFilters(entries);
---

<div data-lab-collection-root data-scroll-to-results={limited ? "" : undefined} class="collection">
  <div class="filters" role="group" aria-label="Filter lab notes" data-lab-filters hidden>
    {filters.map(({ id, label }) => (
      <button type="button" class="filter" data-filter={id} aria-pressed={id === "all" ? "true" : "false"}>{label}</button>
    ))}
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>
  <ul data-lab-collection data-filter="all" class:list={[{ "is-limited": limited }]}>
    {entries.map((item, index) => {
      const slug = item.id.replace(/\.mdx$/, "");
      return (
        <li data-lab-card data-tags={item.data.tags.join("|")} class:list={["index-row", { "beyond-highlight": index >= labHomeLimit }]} data-reveal={limited ? `lab-${index}` : undefined}>
          <div>
            <p class="font-mono text-xs text-muted">{item.data.date.slice(0, 4)}</p>
            <div class="mt-2 flex flex-wrap gap-2">
              {item.data.tags.map((tag) => (
                <span class="font-mono text-xs text-muted border border-line rounded-sm px-2 py-0.5">{tag}</span>
              ))}
            </div>
          </div>
          <div>
            <Heading class="text-2xl md:text-3xl">
              <a href={`/lab/${slug}`} class="card-link group no-underline transition-colors group-hover:text-accent">
                {item.data.title}
                <span class="motion-arrow" aria-hidden="true"> ↗</span>
              </a>
            </Heading>
            <p class="mt-4 max-w-2xl text-muted leading-relaxed">{item.data.summary}</p>
            <p class="card-cta font-mono text-xs text-accent">Read learning detail <span class="motion-arrow" aria-hidden="true">→</span></p>
          </div>
        </li>
      );
    })}
  </ul>
  {limited && (
    <a href="/lab" class:list={["text-link", "view-all", { "is-hidden": total <= labHomeLimit }]}>
      View all lab notes ({total}) <span class="motion-arrow" aria-hidden="true">↗</span>
    </a>
  )}
</div>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 4px 8px; margin-bottom: 8px; }
  .filters[hidden] { display: none; }
  .filter { min-height: 44px; padding: 0 16px; border: 1px solid transparent; border-radius: 2px; background: none; color: var(--color-muted); font: 12px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; transition: color 250ms ease, border-color 250ms ease; }
  .filter:hover { color: var(--color-ink); }
  .filter[aria-pressed="true"] { color: var(--color-ink); border-color: var(--color-line); }
  .index-row { position: relative; }
  .card-link::after { content: ""; position: absolute; inset: 0; }
  .card-link:focus-visible { outline: none; }
  .index-row:has(.card-link:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 6px; }
  .index-row[hidden] { display: none; }
  .card-cta { display: inline-block; margin-top: 16px; }
  .view-all { margin-top: 24px; }
  .view-all.is-hidden { display: none; }
  .is-limited[data-filter="all"] .beyond-highlight { display: none; }
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .index-row:hover .card-link { color: var(--color-accent); }
    .index-row:hover .card-cta .motion-arrow { transform: translateX(2px); }
  }
</style>

<script>
  let abort: AbortController | null = null;
  function initLabFilters() {
    abort?.abort();
    abort = new AbortController();
    const { signal } = abort;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const scrollToResults = (filters: HTMLElement) => {
      const headerBottom = document.getElementById("site-header")?.getBoundingClientRect().bottom ?? 0;
      const delta = filters.getBoundingClientRect().top - (headerBottom + 28);
      if (Math.abs(delta) <= 64) return;
      window.scrollBy({ top: delta, behavior: reduce.matches ? "auto" : "smooth" });
    };
    document.querySelectorAll<HTMLElement>("[data-lab-collection-root]").forEach((root) => {
      const list = root.querySelector<HTMLElement>("[data-lab-collection]");
      const filters = root.querySelector<HTMLElement>("[data-lab-filters]");
      const status = root.querySelector<HTMLElement>("[data-filter-status]");
      if (!list || !filters) return;
      const buttons = [...filters.querySelectorAll<HTMLButtonElement>("[data-filter]")];
      const cards = [...list.querySelectorAll<HTMLElement>("[data-lab-card]")];
      filters.hidden = false;
      const apply = (filter: string, label: string) => {
        list.dataset.filter = filter;
        cards.forEach((card) => {
          const tags = (card.dataset.tags ?? "").split("|");
          card.hidden = filter !== "all" && !tags.includes(filter);
        });
        buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.filter === filter)));
        if (status) {
          const shown = cards.filter((card) => !card.hidden && getComputedStyle(card).display !== "none").length;
          status.textContent = `Showing ${shown} ${filter === "all" ? "" : `${label} `}note${shown === 1 ? "" : "s"}`;
        }
        if (!reduce.matches) list.animate([{ opacity: 0.3 }, { opacity: 1 }], { duration: 200, easing: "ease-out" });
        if (root.hasAttribute("data-scroll-to-results")) requestAnimationFrame(() => scrollToResults(filters));
      };
      buttons.forEach((button) => button.addEventListener("click", () => {
        if (button.getAttribute("aria-pressed") === "true") return;
        apply(button.dataset.filter ?? "all", button.textContent?.trim() ?? "");
      }, { signal }));
    });
  }
  document.addEventListener("astro:page-load", initLabFilters);
  document.addEventListener("astro:before-swap", () => abort?.abort());
</script>
