---
import { nav, safeExternalUrl, site } from "../data/site";

const year = new Date().getFullYear();
const aiServices = safeExternalUrl(site.aiServicesUrl);
const github = safeExternalUrl(site.socials.github);
const linkedin = safeExternalUrl(site.socials.linkedin);
const onHome = Astro.url.pathname === "/";
const mailto = safeExternalUrl(`mailto:${site.email}`);
---

<footer class="border-t border-line px-5 py-10 text-ink md:px-6 md:py-14">
  <div class="portfolio-surface mx-auto max-w-[1400px] border border-line p-6 md:p-10">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr] lg:gap-12">
      <div>
        <p class="font-display text-xl font-semibold tracking-tight">{site.name}</p>
        <p class="mt-3 max-w-sm text-sm text-muted">{site.tagline}</p>
        {mailto && <a href={mailto} class="mt-5 inline-flex min-h-11 items-center bg-accent px-4 py-2 text-sm font-semibold text-mist no-underline transition-colors hover:bg-ink">Email me ↗</a>}
      </div>
      <nav aria-label="Footer">
        <p class="mb-3 font-display font-semibold">Menu</p>
        <ul>
          {nav.map((item) => <li><a href={`${onHome ? "" : "/"}#${item.id}`} class="inline-flex min-h-11 items-center text-sm text-muted no-underline transition-colors hover:text-accent">{item.label}</a></li>)}
          <li><a href="/resume" class="inline-flex min-h-11 items-center text-sm text-muted no-underline transition-colors hover:text-accent">Resume</a></li>
        </ul>
      </nav>
      <div>
        <p class="mb-3 font-display font-semibold">Connect</p>
        <ul>
          {aiServices && <li><a href={aiServices} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm text-muted no-underline transition-colors hover:text-accent">AI Services ↗</a></li>}
          {github && <li><a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm text-muted no-underline transition-colors hover:text-accent">GitHub ↗</a></li>}
          {linkedin && <li><a href={linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm text-muted no-underline transition-colors hover:text-accent">LinkedIn ↗</a></li>}
        </ul>
      </div>
    </div>
    <div class="mt-8 flex flex-col items-center gap-3 border-t border-line pt-6">
      <p class="text-xs font-semibold text-muted">Social media</p>
      <div class="flex gap-3">
        {github && <a href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="flex size-10 items-center justify-center border border-line bg-mist transition-colors hover:border-accent"><img src="/images/icons/github.svg" alt="" width="20" height="20" /></a>}
        {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="flex size-10 items-center justify-center border border-line bg-mist transition-colors hover:border-accent"><img src="/images/icons/linkedin.svg" alt="" width="20" height="20" /></a>}
      </div>
    </div>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5 text-xs text-muted">
      <p>© {year} {site.name}.</p>
      <p>Jakarta, Indonesia</p>
    </div>
  </div>
</footer>
